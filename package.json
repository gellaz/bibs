{
	"name": "bibs",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"postinstall": "lefthook install",
		"dev": "concurrently -n api,admin,customer,seller -c blue,green,cyan,magenta \"bun run dev:api\" \"bun run dev:admin\" \"bun run dev:customer\" \"bun run dev:seller\"",
		"dev:api": "bun run --filter @bibs/api dev",
		"dev:customer": "bun run --filter @bibs/customer dev",
		"dev:seller": "bun run --filter @bibs/seller dev",
		"dev:admin": "bun run --filter @bibs/admin dev",
		"dev:emails": "bun run --filter @bibs/emails dev",
		"test": "bun run --filter @bibs/emails test && bun run --filter @bibs/api test && bun run --filter @bibs/customer test",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"infra:up": "docker compose up -d",
		"infra:down": "docker compose down",
		"infra:reset": "docker compose down -v",
		"db:generate": "bun run --cwd apps/api db:generate",
		"db:migrate": "bun run --cwd apps/api db:migrate",
		"db:push": "bun run --cwd apps/api db:push",
		"db:studio": "bun run --cwd apps/api db:studio",
		"db:seed": "bun run --cwd apps/api db:seed",
		"db:reset": "docker compose down -v && docker compose up -d --wait && bun run db:migrate && bun run db:seed",
		"skills:update": "bunx skills update --project --yes && printf 'Y\\n' | npx --yes impeccable skills update && rm -rf .github/skills"
	},
	"catalog": {
		"@aws-sdk/client-s3": "^3.1139.0",
		"@elysiajs/eden": "^1.4.9",
		"@hookform/resolvers": "^5.9.1",
		"@inlang/paraglide-js": "^2.25.4",
		"@rolldown/plugin-babel": "^0.2.4",
		"@sinclair/typebox": "^0.34.52",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-query": "5.103.2",
		"@tanstack/react-query-devtools": "5.103.2",
		"@tanstack/react-router": "1.170.39",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.168.58",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/router-plugin": "1.168.40",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/leaflet": "^1.9.22",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/node": "^22.20.4",
		"@types/pg": "8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"better-auth": "1.7.5",
		"elysia": "1.4.30",
		"jsdom": "^29.1.1",
		"leaflet": "^1.9.4",
		"leaflet.markercluster": "^1.5.3",
		"lucide-react": "^1.48.0",
		"pg": "^8.23.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-easy-crop": "^6.2.3",
		"react-email": "^6.11.0",
		"react-hook-form": "^7.88.0",
		"react-leaflet": "^5.0.0",
		"react-leaflet-cluster": "^4.1.3",
		"react-resizable-panels": "^4.13.3",
		"sharp": "^0.35.4",
		"stripe": "^22.6.2",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.1",
		"vitest": "^4.1.11",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@inlang/paraglide-js": "catalog:",
		"@rolldown/plugin-babel": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/devtools-vite": "catalog:",
		"@tanstack/react-start": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"concurrently": "^10.0.5",
		"lefthook": "^2.1.14",
		"typescript": "^6.0.3",
		"vite": "catalog:"
	}
}
