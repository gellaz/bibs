{
	"name": "@bibs/api",
	"version": "1.0.50",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun --external sharp",
		"test": "bun run test:unit && bun run test:integration",
		"test:unit": "bun test tests/unit --isolate",
		"test:integration": "bun run test:image && bun test tests/integration --parallel=4 --isolate --timeout 180000",
		"test:image": "docker build --quiet --tag bibs-postgis-test:latest ../../docker/postgis",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:clean": "rm -rf src/db/migrations && echo 'Migrations removed'",
		"db:seed": "bun run src/scripts/seed.ts",
		"stripe:bootstrap": "bun run src/scripts/stripe-bootstrap.ts",
		"create-admin": "bun run src/scripts/create-admin.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "catalog:",
		"@bibs/emails": "workspace:*",
		"better-auth": "catalog:",
		"croner": "^6.0.7",
		"drizzle-orm": "^0.45.4",
		"file-type": "^22.3.0",
		"hono": "catalog:",
		"pg": "catalog:",
		"pino": "^10.4.0",
		"sharp": "catalog:",
		"stripe": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@hono/cli": "^1.0.0-rc.8",
		"@types/pg": "catalog:",
		"bun-types": "1.4.4",
		"drizzle-kit": "^0.31.11",
		"testcontainers": "^12.2.1"
	},
	"module": "src/index.ts",
	"types": "src/types.ts",
	"exports": {
		".": {
			"types": "./src/types.ts",
			"default": "./src/index.ts"
		},
		"./schemas": {
			"default": "./src/schemas/forms/index.ts"
		},
		"./validation-rule": {
			"default": "./src/http/validation-rule.ts"
		}
	}
}
